{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TradingPlatform": "Host=localhost;Port=5432;Database=TradingProject;Username=admin;Password=admin",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "TradingPlatform",
    "Audience": "TradingPlatform",
    "SigningKey": "CHANGE-ME-to-a-long-random-signing-key-32chars-min",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Credentials": {
    "EncryptionKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Trading": {
    "LiveTradingEnabled": false,
    "DefaultMode": "PAPER",
    "AllowLiveWithoutTwoFactor": false,
    "KillSwitchEnabled": false,
    "HostBotEngine": true,
    "AutoStartSamplePaperBot": false,
    "BotEngineIntervalSeconds": 15,
    "KlineLimit": 120,
    "UniverseRefreshMinutes": 15,
    "UniverseCachePath": "data/futures-universe.json",
    "PaperDefaultBalance": 10000,
    "PaperFeeBps": 10,
    "PaperSlippageBps": 5,
    "Scanner": {
      "MinQuoteVolumeUsdt": 10000000,
      "MaxSpreadBps": 8,
      "MinTrades24h": 5000,
      "MaxAbsFundingRate": 0.01,
      "MinScanScore": 0.25,
      "Weights": {
        "QuoteVolume": 0.25,
        "Trades24h": 0.15,
        "Volatility": 0.10,
        "Spread": 0.15,
        "OpenInterest": 0.05,
        "Funding": 0.10,
        "TrendQuality": 0.10,
        "DataQuality": 0.10
      }
    },
    "Scalping": {
      "Enabled": false,
      "AllowLive": false,
      "MaxHoldBars": {
        "1m": 15,
        "3m": 12,
        "5m": 8,
        "15m": 6
      }
    },
    "PriceAction": {
      "Enabled": false,
      "AllowLive": false
    }
  },
  "Binance": {
    "RestBaseUrl": "https://api.binance.com",
    "WebSocketBaseUrl": "wss://stream.binance.com:9443",
    "TestnetRestBaseUrl": "https://testnet.binance.vision",
    "TestnetWebSocketBaseUrl": "wss://stream.testnet.binance.vision",
    "RecvWindowMs": 5000,
    "RequestTimeoutSeconds": 15,
    "FuturesRestBaseUrl": "https://fapi.binance.com"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Seed": {
    "AdminEmail": "admin@localhost",
    "AdminPassword": "ChangeMe_Admin_123!"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
