{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TradingPlatform": "Host=localhost;Port=5432;Database=TradingProject;Username=admin;Password=admin",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "TradingPlatform",
    "Audience": "TradingPlatform",
    "SigningKey": "CHANGE-ME-to-a-long-random-signing-key-32chars-min",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Credentials": {
    "EncryptionKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Trading": {
    "LiveTradingEnabled": false,
    "AllowLiveWithoutTwoFactor": false,
    "KillSwitchEnabled": false,
    "HostBotEngine": true,
    "BotEngineIntervalSeconds": 15,
    "KlineLimit": 120,
    "UniverseRefreshMinutes": 15,
    "UniverseCachePath": "data/futures-universe.json",
    "Scanner": {
      "MinQuoteVolumeUsdt": 10000000,
      "MaxSpreadBps": 8,
      "MinTrades24h": 5000,
      "MaxAbsFundingRate": 0.01,
      "MinScanScore": 0.25,
      "Weights": {
        "QuoteVolume": 0.25,
        "Trades24h": 0.15,
        "Volatility": 0.10,
        "Spread": 0.15,
        "OpenInterest": 0.05,
        "Funding": 0.10,
        "TrendQuality": 0.10,
        "DataQuality": 0.10
      }
    },
    "Scalping": {
      "Enabled": false,
      "AllowLive": false,
      "MaxHoldBars": {
        "1m": 15,
        "3m": 12,
        "5m": 8,
        "15m": 6
      }
    },
    "CrossSectionalReversal": {
      "Enabled": true,
      "PaperEnabled": false,
      "LiveEnabled": true,
      "Return15mEnabled": true,
      "Return1hEnabled": true,
      "MaxLeverage": 3,
      "MaxTotalPositions": 10,
      "MaxLongPositions": 5,
      "MaxShortPositions": 5,
      "MaxCrossSectionalRiskPercent": 2.0,
      "MaxPerPositionRiskPercent": 0.25,
      "MinimumEligibleSymbols": 30,
      "HistoryBarsRequired": 96,
      "MinimumUniverseSize": 30,
      "RebalanceIntervalMinutes": 15,
      "MinimumPositionAgeMinutes": 15,
      "RebalanceCooldownMinutes": 15,
      "MaxClusterPositions": 3,
      "MaxClusterRiskPercent": 0.75,
      "MaxDirectionalRiskPercent": 1.5,
      "MaxHeat": 1.0,
      "FundingRiskEnabled": false,
      "VolatilitySafetyEnabled": false,
      "EqualRiskSizing": true,
      "DynamicRiskWeighting": false,
      "TopDecilePercent": 10,
      "BottomDecilePercent": 10,
      "RankingClock": "BTCUSDT_15M",
      "AllowLong": true,
      "AllowShort": true,
      "ProductionApproval": "INSUFFICIENT_EVIDENCE"
    },
    "PriceAction": {
      "Enabled": false,
      "AllowLive": false,
      "PaperEnabled": false,
      "LiveEnabled": false,
      "Candidates": {
        "cpa_near_miss_sweep_contextual_5m": { "Enabled": false },
        "cpa_near_miss_sweep_strict_5m": { "Enabled": false },
        "cpa_near_miss_pullback_contextual_5m": { "Enabled": false },
        "cpa_near_miss_wm_contextual_5m": { "Enabled": false },
        "cpa_near_miss_wm_strict_5m": { "Enabled": false },
        "cpa_near_miss_compression_continuation_5m": { "Enabled": false },
        "cpa_near_miss_mtf_strict_5m": { "Enabled": false }
      }
    }
  },
  "Binance": {
    "RestBaseUrl": "https://api.binance.com",
    "WebSocketBaseUrl": "wss://stream.binance.com:9443",
    "TestnetRestBaseUrl": "https://testnet.binance.vision",
    "TestnetWebSocketBaseUrl": "wss://stream.testnet.binance.vision",
    "RecvWindowMs": 5000,
    "RequestTimeoutSeconds": 15,
    "FuturesRestBaseUrl": "https://fapi.binance.com"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Seed": {
    "AdminEmail": "admin@localhost",
    "AdminPassword": "ChangeMe_Admin_123!"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "News": {
    "Enabled": true,
    "Mode": "Live",
    "PollMinutes": 5,
    "Providers": [ "binance", "official-blogs", "rss" ],
    // Paid sources stay off. To use one later, add its name here and set the matching environment variable:
    // News__CoinGeckoApiKey, News__CoinDeskApiKey, News__CryptoPanicToken, News__FredApiKey.
    "ProviderPollMinutes": {
      "gdelt": 30,
      "binance": 5,
      "official-blogs": 30,
      "rss": 15
    },
    "Strategy": {
      "Enabled": true,
      "MinNewsConfidence": 0.75,
      "MinNewsImpact": 0.70,
      "MinRelevance": 0.35,
      "MinTotalScore": 75,
      "MinNewsScore": 25,
      "MinMarketScore": 20,
      "MaxNewsAgeMinutes": 60,
      "ConflictMarketScore": 25,
      "Weights": {
        "News": 40,
        "Trend": 15,
        "Volume": 15,
        "TakerImbalance": 10,
        "Structure": 10,
        "Volatility": 10
      },
      "Timeframes": {
        "Execution": "15m",
        "Flow": "5m",
        "Structure": "15m",
        "Trend": "1h"
      }
    }
  }
}
