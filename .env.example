# Copy this file to .env and fill in local values.
# NEVER commit a real .env file or real API keys.

# ---------------------------------------------------------------------------
# ASP.NET
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=TradingProject
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
ConnectionStrings__TradingPlatform=Host=localhost;Port=5432;Database=TradingProject;Username=admin;Password=admin

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# ---------------------------------------------------------------------------
# Auth / JWT  (generate a long random secret; 32+ characters)
# ---------------------------------------------------------------------------
Jwt__Issuer=TradingPlatform
Jwt__Audience=TradingPlatform
Jwt__SigningKey=CHANGE-ME-to-a-long-random-signing-key-32chars-min
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Seeded first admin (change after first login)
Seed__AdminEmail=admin@localhost
Seed__AdminPassword=ChangeMe_Admin_123!

# ---------------------------------------------------------------------------
# Credential encryption (32-byte key, standard base64)
# Generate:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# ---------------------------------------------------------------------------
Credentials__EncryptionKey=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---------------------------------------------------------------------------
# Trading safety — LIVE IS OFF BY DEFAULT
# ---------------------------------------------------------------------------
Trading__LiveTradingEnabled=false
Trading__DefaultMode=PAPER
Trading__AllowLiveWithoutTwoFactor=false
Trading__KillSwitchEnabled=false
Trading__PaperDefaultBalance=10000
Trading__PaperFeeBps=10
Trading__PaperSlippageBps=5

# ---------------------------------------------------------------------------
# Binance
# Public market data is used for paper trading.
# Secrets belong only here or in a secret manager — never in Angular.
# ---------------------------------------------------------------------------
Binance__RestBaseUrl=https://api.binance.com
Binance__WebSocketBaseUrl=wss://stream.binance.com:9443
Binance__TestnetRestBaseUrl=https://testnet.binance.vision
Binance__TestnetWebSocketBaseUrl=wss://stream.testnet.binance.vision
Binance__RecvWindowMs=5000
Binance__RequestTimeoutSeconds=15

# Optional platform-level testnet keys for integration tests (not required for paper)
Binance__TestnetApiKey=
Binance__TestnetApiSecret=

# ---------------------------------------------------------------------------
# CORS / UI
# ---------------------------------------------------------------------------
Cors__AllowedOrigins=http://localhost:4200,http://localhost:8080

# ---------------------------------------------------------------------------
# Email notifications (optional in development)
# ---------------------------------------------------------------------------
Email__Enabled=false
Email__SmtpHost=localhost
Email__SmtpPort=25
Email__From=noreply@localhost

# ---------------------------------------------------------------------------
# OpenTelemetry (leave empty to disable OTLP export)
# ---------------------------------------------------------------------------
OpenTelemetry__OtlpEndpoint=
